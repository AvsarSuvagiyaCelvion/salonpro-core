# ==============================================================================
# StudioDesk Cloud ERP & Public Booking Engine - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL 14+ / Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# Optional custom CA certificate for strict SSL verification in production
DATABASE_CA_CERT=

# Application Security & Session Secret (Used for stateless JWT session cookies)
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_secret
# Optional 32-byte encryption secret for encrypting salon Meta WhatsApp Cloud tokens at rest (AES-256-GCM)
WHATSAPP_TOKEN_ENC_KEY=

# Canonical Application & Domain Configuration
NEXT_PUBLIC_APP_URL=https://www.studiodeskapp.com
# VERCEL_URL is automatically provided by Vercel deployments
# VERCEL_URL=StudioDesk-plum.vercel.app
NEXT_PUBLIC_ROOT_DOMAIN=studiodeskapp.com

# Platform & Customer Support Configuration
NEXT_PUBLIC_SUPPORT_PHONE=8320653782
NEXT_PUBLIC_SUPPORT_EMAIL=studiodeskapp@gmail.com
NEXT_PUBLIC_DEFAULT_SALON_NAME=Glow Studio

# Meta WhatsApp Cloud API (Automated PDF Bills & Receipts)
WHATSAPP_CLOUD_API_TOKEN=EAAB...replace_with_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_TEMPLATE_NAME=invoice_receipt
WHATSAPP_TEMPLATE_LANG=en

# Twilio WhatsApp API (Alternative WhatsApp Provider Fallback)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Platform Super-Admin Credentials
ADMIN_EMAIL=admin@StudioDesk.app
ADMIN_PASSWORD=replace_with_secure_admin_password

# Demo Seeding Credentials (Used by scripts/seed-demo.js)
DEMO_OWNER_EMAIL=owner@glowstudio.com
DEMO_OWNER_PASSWORD=GlowStudio@2026!
ALLOW_WIPE=false

# Razorpay Payment Gateway (Must use rzp_live_* keys in production; rzp_test_* for local development)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_WEBHOOK_SECRET=...

# Supabase Storage Configuration (Server-Only - NEVER expose to browser)
# Bucket name: salon-media (Public-read)
SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace_with_supabase_service_role_secret
