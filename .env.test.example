# ==============================================================================
# StudioDesk Automated QA & Integration Test Environment Configuration
# ==============================================================================
# SAFETY GUARD: Must point to an isolated test database (NOT production / .env.local).
# The QA test runner strictly verifies that DATABASE_URL != .env.local DATABASE_URL,
# and that the database name contains 'test' (e.g. StudioDesk_test).
# ==============================================================================

DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/StudioDesk_test
SESSION_SECRET=supersecret-session-key-StudioDesk-2026-xyz
SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...test_service_role_key

BASE_URL=http://localhost:3100
PORT=3100
NEXT_PUBLIC_APP_URL=http://localhost:3100
TEST_BASE_URL=http://localhost:3100
ALLOW_WIPE=true
